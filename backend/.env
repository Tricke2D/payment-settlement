# Database
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/settlement_engine?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_NAME=settlement_engine
DB_USER=postgres
DB_PASSWORD=postgres123

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_SETTLEMENT=settlement-events
KAFKA_TOPIC_AUDIT=audit-logs

# Server
NODE_ENV=development
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Payment Gateway
STRIPE_API_KEY=sk_test_dummy_key
MIDTRANS_SERVER_KEY=dummy_key

# Logging
LOG_LEVEL=debug